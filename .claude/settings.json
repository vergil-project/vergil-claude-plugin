{
  "permissions": {
    "allow": ["Bash(vrg-*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vergil@vergil-marketplace": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
