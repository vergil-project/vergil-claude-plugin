#!/usr/bin/env bash
# validate-custom — repo-local validation hook discovered by
# vrg-validate. Checks every skill's SKILL.md frontmatter, the tool sets
# of the merge reviewer and the implementer, every agent's model pin
# against the model map and the git mode of every hook script, then runs
# the hook test suites under hooks/tests/.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

status=0

# Print the value of top-level frontmatter key $2 in file $1, with
# surrounding quotes removed. A block scalar (`key: >` or `key: |`) yields
# its first non-empty indented line. Prints nothing when the key is absent
# or empty.
frontmatter_value() {
	awk -v key="$2" '
		NR == 1 { next }
		/^---[[:space:]]*$/ { exit }
		block {
			if ($0 ~ /^[[:space:]]+[^[:space:]]/) {
				sub(/^[[:space:]]+/, "")
				print
				exit
			}
			if ($0 ~ /^[^[:space:]]/) { exit }
			next
		}
		index($0, key ":") == 1 {
			v = substr($0, length(key) + 2)
			sub(/^[[:space:]]+/, "", v)
			sub(/[[:space:]]+$/, "", v)
			if (v ~ /^[>|][-+]?$/) { block = 1; next }
			if (v ~ /^".*"$/ || v ~ /^'"'"'.*'"'"'$/) {
				v = substr(v, 2, length(v) - 2)
			}
			if (v != "") { print v }
			exit
		}
	' "$1"
}

# Every skills/<dir>/ must hold a SKILL.md whose YAML frontmatter has a
# non-empty `name` equal to <dir> and a non-empty `description`.
check_skill_frontmatter() {
	local dir skill file name description rc=0 count=0
	for dir in "$ROOT"/skills/*/; do
		[[ -d "$dir" ]] || continue # unmatched glob: no skill directories
		skill="$(basename "$dir")"
		file="skills/$skill/SKILL.md"
		count=$((count + 1))
		if [[ ! -f "$ROOT/$file" ]]; then
			echo "ERROR: $file: missing" >&2
			rc=1
			continue
		fi
		if [[ "$(head -n 1 "$ROOT/$file")" != "---" ]] ||
			[[ "$(tail -n +2 "$ROOT/$file" | grep -c '^---[[:space:]]*$' || true)" -lt 1 ]]; then
			echo "ERROR: $file: no YAML frontmatter (must open and close with ---)" >&2
			rc=1
			continue
		fi
		name="$(frontmatter_value "$ROOT/$file" name)"
		description="$(frontmatter_value "$ROOT/$file" description)"
		if [[ -z "$name" ]]; then
			echo "ERROR: $file: frontmatter 'name' is missing or empty" >&2
			rc=1
		elif [[ "$name" != "$skill" ]]; then
			echo "ERROR: $file: frontmatter name '$name' does not match directory '$skill'" >&2
			rc=1
		fi
		if [[ -z "$description" ]]; then
			echo "ERROR: $file: frontmatter 'description' is missing or empty" >&2
			rc=1
		fi
	done
	if [[ "$count" -eq 0 ]]; then
		echo "ERROR: no skill directories found under skills/" >&2
		rc=1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Skill frontmatter: $count skills OK"
	fi
	return "$rc"
}

# agents/<agent>.md must exist with YAML frontmatter whose `tools` is
# exactly $2. Pins an agent's tool set, so a tool cannot be added to a
# deliberately restricted agent without this check failing.
check_agent_tools() {
	local agent="$1" expected="$2" file tools
	file="agents/$agent.md"
	if [[ ! -f "$ROOT/$file" ]]; then
		echo "ERROR: $file: missing" >&2
		return 1
	fi
	if [[ "$(head -n 1 "$ROOT/$file")" != "---" ]] ||
		[[ "$(tail -n +2 "$ROOT/$file" | grep -c '^---[[:space:]]*$' || true)" -lt 1 ]]; then
		echo "ERROR: $file: no YAML frontmatter (must open and close with ---)" >&2
		return 1
	fi
	# frontmatter_value reads the first `tools:` line only; a second one
	# could override it when the agent loads, so exactly one must exist.
	if [[ "$(awk 'NR == 1 { next } /^---[[:space:]]*$/ { exit } /^tools:/' "$ROOT/$file" | wc -l)" -ne 1 ]]; then
		echo "ERROR: $file: frontmatter must have exactly one 'tools' line" >&2
		return 1
	fi
	tools="$(frontmatter_value "$ROOT/$file" tools)"
	if [[ "$tools" != "$expected" ]]; then
		echo "ERROR: $file: frontmatter 'tools' is '$tools', must be exactly '$expected'" >&2
		return 1
	fi
	echo "Agent tools: $agent OK ($expected)"
}

# Print the agents table of the model map $1 as tab-separated
# "<name>\t<model>\t<reason>" lines, one per row whose first cell is
# `vergil:<name>`. The table is the one under the page's `## Agents`
# heading, up to the next heading; backticks and surrounding spaces are
# stripped from the model cell, spaces from the reason cell.
model_map_agent_rows() {
	awk '
		/^#/ { in_agents = ($0 ~ /^## Agents[[:space:]]*$/); next }
		!in_agents || $0 !~ /^[[:space:]]*\|/ { next }
		{
			n = split($0, cell, "|")
			name = cell[2]
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
			if (name !~ /^`vergil:[^`[:space:]]+`$/) { next }
			name = substr(name, 9, length(name) - 9)
			model = (n >= 3) ? cell[3] : ""
			gsub(/`/, "", model)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", model)
			reason = (n >= 4) ? cell[4] : ""
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", reason)
			print name "\t" model "\t" reason
		}
	' "$1"
}

# Every $1/agents/<agent>.md must pin its model: exactly one frontmatter
# `model:` line whose value is haiku, sonnet, opus or inherit, and one row
# in the model map's agents table ($1/docs/site/docs/agents/models.md)
# whose first cell is `vergil:<agent>` and whose Model cell is the same
# value. `inherit` also needs a non-empty Reason cell. Every `vergil:` row
# of the table must name an existing agent file.
check_agent_models() {
	local root="$1" map="docs/site/docs/agents/models.md" rows file agent
	local model row_model row_reason count rc=0 agents=0 seen=" " name
	if [[ ! -f "$root/$map" ]]; then
		echo "ERROR: $map: missing (the model map every agent must be listed in)" >&2
		return 1
	fi
	rows="$(model_map_agent_rows "$root/$map")"
	for file in "$root"/agents/*.md; do
		[[ -f "$file" ]] || continue # unmatched glob: no agent files
		agent="$(basename "$file" .md)"
		file="agents/$agent.md"
		agents=$((agents + 1))
		seen="$seen$agent "
		if [[ "$(head -n 1 "$root/$file")" != "---" ]] ||
			[[ "$(tail -n +2 "$root/$file" | grep -c '^---[[:space:]]*$' || true)" -lt 1 ]]; then
			echo "ERROR: $file: no YAML frontmatter (must open and close with ---)" >&2
			rc=1
			continue
		fi
		# frontmatter_value reads the first `model:` line only; a second
		# one could override it when the agent loads.
		count="$(awk 'NR == 1 { next } /^---[[:space:]]*$/ { exit } /^model:/' "$root/$file" | wc -l | tr -d ' ')"
		if [[ "$count" -ne 1 ]]; then
			echo "ERROR: $file: frontmatter must have exactly one 'model' line (found $count)" >&2
			rc=1
			continue
		fi
		model="$(frontmatter_value "$root/$file" model)"
		case "$model" in
		haiku | sonnet | opus | inherit) ;;
		*)
			echo "ERROR: $file: frontmatter 'model' is '$model', must be haiku, sonnet, opus or inherit" >&2
			rc=1
			continue
			;;
		esac
		count="$(awk -F '\t' -v a="$agent" '$1 == a' <<<"$rows" | wc -l | tr -d ' ')"
		if [[ "$count" -ne 1 ]]; then
			echo "ERROR: $file: $map must have exactly one agents-table row for \`vergil:$agent\` (found $count)" >&2
			rc=1
			continue
		fi
		row_model="$(awk -F '\t' -v a="$agent" '$1 == a { print $2 }' <<<"$rows")"
		row_reason="$(awk -F '\t' -v a="$agent" '$1 == a { print $3 }' <<<"$rows")"
		if [[ "$row_model" != "$model" ]]; then
			echo "ERROR: $file: model is '$model', but $map lists \`vergil:$agent\` as '$row_model'" >&2
			rc=1
			continue
		fi
		if [[ "$model" == inherit && -z "$row_reason" ]]; then
			echo "ERROR: $file: model is 'inherit', but its row in $map gives no reason" >&2
			rc=1
		fi
	done
	while IFS=$'\t' read -r name _; do
		[[ -n "$name" ]] || continue
		if [[ "$seen" != *" $name "* ]]; then
			echo "ERROR: $map: agents-table row \`vergil:$name\` names no agents/$name.md" >&2
			rc=1
		fi
	done <<<"$rows"
	if [[ "$agents" -eq 0 ]]; then
		echo "ERROR: no agent files found under agents/" >&2
		rc=1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Agent models: $agents agents OK"
	fi
	return "$rc"
}

# Every hook command in $1/hooks/hooks.json must name a script tracked in
# git at $1 with mode 100755: Claude Code cannot run a hook script that is
# not executable. Each command must start with ${CLAUDE_PLUGIN_ROOT}/; its
# first word, less that prefix, is the script's repo-relative path.
check_hook_modes() {
	local root="$1" file="hooks/hooks.json" commands command path entry mode
	# shellcheck disable=SC2016 # the literal prefix hooks.json carries, not an expansion
	local rc=0 count=0 prefix='${CLAUDE_PLUGIN_ROOT}/'
	if [[ ! -f "$root/$file" ]]; then
		echo "ERROR: $file: missing" >&2
		return 1
	fi
	if ! command -v jq >/dev/null 2>&1; then
		echo "ERROR: $file: jq is required to read hook commands and is not on PATH" >&2
		return 1
	fi
	if ! commands="$(jq -r '.hooks[][].hooks[].command' "$root/$file")"; then
		echo "ERROR: $file: could not read hook commands (.hooks[][].hooks[].command)" >&2
		return 1
	fi
	while IFS= read -r command; do
		[[ -n "$command" ]] || continue
		count=$((count + 1))
		if [[ "$command" != "$prefix"* ]]; then
			echo "ERROR: $file: hook command '$command' does not start with $prefix, so its script cannot be checked" >&2
			rc=1
			continue
		fi
		path="${command#"$prefix"}"
		path="${path%%[[:space:]]*}"
		if ! entry="$(git -C "$root" ls-files --stage -- "$path")"; then
			echo "ERROR: $path: could not read its git mode" >&2
			rc=1
			continue
		fi
		if [[ -z "$entry" ]]; then
			echo "ERROR: $path: hook script named in $file is not tracked in git" >&2
			rc=1
			continue
		fi
		mode="${entry%% *}"
		if [[ "$mode" != "100755" ]]; then
			echo "ERROR: $path: hook script named in $file has git mode $mode, must be 100755 (executable)" >&2
			rc=1
		fi
	done <<<"$commands"
	if [[ "$count" -eq 0 ]]; then
		echo "ERROR: $file: no hook commands found" >&2
		rc=1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Hook script modes: $count hook scripts OK"
	fi
	return "$rc"
}

# Sourced (by the hook-modes and agent-models tests): define the checks, run nothing.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
	return 0
fi

echo "Running: skill frontmatter check"
check_skill_frontmatter || status=1

# The merge-review reviewer reads and reports only: no Write, Edit or Bash.
echo "Running: agent tools check"
check_agent_tools merge-reviewer "Read, Glob, Grep" || status=1
# The writer edits, validates and commits, and never dispatches an agent.
check_agent_tools implementer "Read, Edit, Write, Glob, Grep, Bash" || status=1

echo "Running: agent model check"
check_agent_models "$ROOT" || status=1

echo "Running: hook script mode check"
check_hook_modes "$ROOT" || status=1

for t in "$ROOT"/hooks/tests/*.test.sh; do
	echo "Running: $t"
	bash "$t" || status=1
done
exit "$status"
